# Azure Blob Keys
# <name of azure blob container>
CONTAINER_NAME=
# Azure blob storage account key
AZURE_STORAGE_ACCOUNT_KEY=

# name of the azure blob storage resource.
ACCOUNT_NAME=

# App title/name
APP_TITLE="Optimus Central Docs"

# Orangaization name
ORG_NAME="Optimum Data Analytics"

# APP Configure

APP_BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:7007

# Github Fine-grained personal access tokens
# with follo
# Permission	        Level   	    Why
# Administration	Read and write	    Creating the repo
# Contents	        Read and write	    Pushing the generated files
# Workflows	        Read and write	    Pushing .github/workflows/push_docs.yaml
# Metadata	        Read	            Required by default
GITHUB_TOKEN=

# github oraganization account name
GITHUB_ORGANIZATION_NAME="optimum-data-analytics-demo"